# Copy to .env next to compose.yaml to change settings. Every line is optional; the values shown are the defaults.
# Do not put API keys here: they belong in ~/.config/factory/env (chmod 600), read through FACTORY_ENV_FILE.

# FACTORY_PORT=8787
# FACTORY_DATA_DIR=/home/<you>/factory-docker
# FACTORY_ENV_FILE=/home/<you>/.config/factory/env
# FACTORY_UID=1000
# FACTORY_GID=1000

# Agents
# FACTORY_DEFAULT_AGENT_CLI=claude        # or codex
# FACTORY_NODE_SLOTS=4                    # agents at the same time, 1-16
# FACTORY_MULTI_TEAM=1
# FACTORY_LEAD_TIMEOUT_SECONDS=600
# FACTORY_LEAD_EFFORT=medium              # low, medium, high, xhigh
# FACTORY_LEAD_MODEL=

# Where the CLIs are installed on this machine
# CLAUDE_INSTALL_DIR=/home/<you>/.local/share/claude
# CODEX_PACKAGE_DIR=/home/<you>/.local/npm/lib/node_modules/@openai/codex

# Budgets (default: not limited, usage is still recorded)
# FACTORY_BUDGET_TASK_TOKENS=9007199254740991
# FACTORY_BUDGET_DAY_TOKENS=9007199254740991

# FACTORY_OPEN_LOGIN=1                    # 0: require the one-time token printed in the log
# FACTORY_DOC_WORKER=on                   # off: no PDF/Office text extraction
