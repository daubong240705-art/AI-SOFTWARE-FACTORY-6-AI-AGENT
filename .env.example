# Development values only. Copy to .env; use separate credentials for deployed environments.
POSTGRES_DB=asf
POSTGRES_USER=asf
POSTGRES_PASSWORD=asf-local-development
ASF_DATABASE_URL=postgresql+psycopg://asf:asf-local-development@localhost:54329/asf
ASF_REDIS_URL=redis://localhost:56379/0
ASF_ENVIRONMENT=development
ASF_LOG_LEVEL=INFO
ASF_API_PORT=18000
ASF_DASHBOARD_PORT=13000
ASF_POSTGRES_PORT=54329
ASF_REDIS_PORT=56379
# Server-side only, when running Next.js outside Compose:
API_INTERNAL_URL=http://127.0.0.1:18000
