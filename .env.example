# Development values only. Copy to .env; use separate credentials for deployed environments.
POSTGRES_DB=asf
POSTGRES_USER=asf
POSTGRES_PASSWORD=asf-local-development
ASF_DATABASE_URL=postgresql+psycopg://asf:asf-local-development@localhost:54329/asf
ASF_REDIS_URL=redis://localhost:56379/0
ASF_ENVIRONMENT=development
ASF_LOG_LEVEL=INFO
ASF_API_PORT=18000
ASF_DASHBOARD_PORT=13000
ASF_POSTGRES_PORT=54329
ASF_REDIS_PORT=56379
# Server-side only, when running Next.js outside Compose:
API_INTERNAL_URL=http://127.0.0.1:18000

# Phase 2 defaults: mock only. Enable live explicitly; token is worker-only.
ASF_LIVE_MODE_ENABLED=false
ASF_ROUTER_API_KEY=
ASF_ROUTER_URL=https://ai.lazy.local/v1
ASF_ROUTER_MODEL=coding-main
ASF_RUN_TOKEN_BUDGET=100000
ASF_RUN_CALL_LIMIT=6
ASF_RUN_RETRY_LIMIT=2
ASF_MODEL_TIMEOUT_SECONDS=60
ASF_MODEL_HTTP_ATTEMPTS=2
ASF_MODEL_MAX_OUTPUT_TOKENS=2000
ASF_DISPATCH_LEASE_SECONDS=45
ASF_DISPATCH_RECOVERY_LIMIT=2

# Phase 3: no default account. Bootstrap interactively with asf_api.manage.
# Change the allowlist when changing ports/domains; JSON array, exact origins.
ASF_ALLOWED_ORIGINS=["http://localhost:13000","http://127.0.0.1:13000","http://localhost:18000","http://127.0.0.1:18000"]
ASF_SESSION_HOURS=8
ASF_SESSION_COOKIE_SECURE=false
# Phase 5: models and integration targets are administrator-owned allowlists.
ASF_MODEL_CATALOG=["coding-main"]
ASF_GITLAB_URL=https://gitlab.lazy.local
ASF_GITLAB_API_TOKEN=
ASF_GITLAB_CA_FILE=
ASF_OPENPROJECT_URL=https://openproject.lazy247.space
ASF_OPENPROJECT_API_TOKEN=
ASF_INTEGRATION_PROFILES_FILE=
ASF_GITLAB_WEBHOOK_SECRET=
ASF_WORKER_LEASE_SECONDS=60
ASF_WORKER_TASK_TIMEOUT_SECONDS=900
ASF_WORKER_RECOVERY_LIMIT=2
# Per-execution coding grant; further capped by the remaining run budget.
ASF_CODING_MODEL_REQUESTS=8
ASF_CODING_MODEL_ALLOWANCE=60000
ASF_CODING_MODEL_OUTPUT_TOKENS=1000
# staging/production force Secure cookies and require HTTPS even if this is false.

# Phase 5 staging verifier secret stays only on API and trusted deploy host.
ASF_DEPLOYMENT_HEALTH_ORIGINS=["https://asf.lazy.local"]
ASF_STAGING_VERIFIER_KEY=
