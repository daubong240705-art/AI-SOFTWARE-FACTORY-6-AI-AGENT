#!/bin/sh
set -eu
iptables -w -N ASF-VALIDATION 2>/dev/null || true
# Commit only this chain atomically; never open a gap while a prior container is running.
iptables-restore -w --noflush <<'RULES'
*filter
-F ASF-VALIDATION
-A ASF-VALIDATION -p tcp -s 192.168.1.51 -m conntrack --ctdir ORIGINAL --ctorigdst 192.168.1.14 --ctorigdstport 18120 -j RETURN
-A ASF-VALIDATION -p tcp -m conntrack --ctdir ORIGINAL --ctorigdst 192.168.1.14 --ctorigdstport 18120 -j DROP
-A ASF-VALIDATION -i br-asf-stage -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
-A ASF-VALIDATION -i br-asf-stage -j DROP
-A ASF-VALIDATION -j RETURN
COMMIT
RULES
iptables -w -C DOCKER-USER -j ASF-VALIDATION 2>/dev/null || iptables -w -I DOCKER-USER 1 -j ASF-VALIDATION
iptables -w -C INPUT -j ASF-VALIDATION 2>/dev/null || iptables -w -I INPUT 1 -j ASF-VALIDATION
