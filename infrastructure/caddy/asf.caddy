asf.lazy.local {
    import internal_only
    tls internal
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy same-origin
    }
    @health path /healthz /readyz
    handle @health {
        reverse_proxy 192.168.1.14:18101
    }
    # All browser API requests use Next's BFF, preserving its cookie/Origin checks.
    handle {
        reverse_proxy 192.168.1.14:18100 {
            flush_interval -1
        }
    }
}
