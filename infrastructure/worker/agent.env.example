# Root-owned /etc/asf-worker/agent.env, mode 0600. Never copy real values to Git.
ASF_WORKER_URL=https://asf.lazy.local
ASF_WORKER_TOKEN=replace-with-one-time-registration-token
ASF_WORKER_CA_FILE=/etc/asf-worker/caddy-root.crt
ASF_WORKER_WORKSPACES=/opt/asf-worker/workspaces
ASF_ROUTER_URL=https://ai.lazy.local/v1
ASF_ROUTER_CA_FILE=/etc/asf-worker/caddy-root.crt
NINE_ROUTER_API_KEY=replace-with-restricted-gateway-key
