[Unit]
Description=ASF outbound coding worker
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/asf-worker/agent
EnvironmentFile=/etc/asf-worker/agent.env
ExecStart=/opt/asf-worker/agent/.venv/bin/python -m workers.coding
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=45
UMask=0077

[Install]
WantedBy=multi-user.target
