{
  "schemaVersion": 2,
  "referenceManifest": "research/factory-v2/reference-manifest.json",
  "rubric": {
    "layout": 25,
    "palette": 20,
    "typography": 15,
    "components": 15,
    "density": 10,
    "interactionGeometry": 10,
    "states": 5
  },
  "targets": {
    "measured": false,
    "qualityMatrixRequired": true,
    "historicalVisualTargets": {
      "overallMinimum": 92,
      "eachScreenMinimum": 91,
      "releaseGate": false
    },
    "source": "plan/factory-v2/uiux-upgrade.md"
  },
  "comparison": {
    "viewportCss": [1600, 1000],
    "dpr": 2,
    "geometryToleranceCssPx": 4,
    "flatColorChannelTolerance": 3,
    "accentChannelTolerance": 6,
    "fixedClock": "2026-11-06T09:00:00+07:00",
    "locale": "vi-VN",
    "maskAllowed": [
      "own-brand",
      "project-names",
      "timestamps",
      "ticket-text",
      "avatars"
    ],
    "maskForbidden": [
      "layout",
      "controls",
      "fonts",
      "columns",
      "broken-content"
    ],
    "paletteStatus": "Original dark raster is a geometry reference. Light theme and Inter are deliberate ASF adaptations, not pixel parity gates."
  },
  "sharedChecks": [
    {
      "id": "shell",
      "group": "layout",
      "expect": "Sidebar/topbar/projectbar/gutter theo tokens, đúng phạm vi global/project"
    },
    {
      "id": "palette",
      "group": "palette",
      "expect": "Light/Dark semantic tokens, readable contrast; System preference and no fake Light reference score."
    },
    {
      "id": "type",
      "group": "typography",
      "expect": "Chữ Việt rõ, size/weight/line-height/baseline theo tokens"
    },
    {
      "id": "primitives",
      "group": "components",
      "expect": "Field/button/card/chip/icon/menu cùng hệ, không native dropdown popup"
    },
    {
      "id": "density",
      "group": "density",
      "expect": "Tiêu đề/nội dung/metadata phân cấp, helper gọn và một primary action theo context"
    },
    {
      "id": "geometry",
      "group": "interactionGeometry",
      "expect": "Không overlap/clipping, arrow/controls căn giữa, scroll và focus đúng"
    },
    {
      "id": "states",
      "group": "states",
      "expect": "Loading/empty/error/stale/partial/offline không giả dữ liệu thành công"
    },
    {
      "id": "locales",
      "group": "typography",
      "expect": "vi/en UI resources, no auto-translation of user or agent content; Vietnamese glyphs and long English labels."
    }
  ],
  "screens": [
    {
      "id": "UI-01",
