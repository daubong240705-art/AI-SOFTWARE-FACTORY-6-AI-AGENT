      "name": "Tạo dự án",
      "priority": 2,
      "components": [
        "AppShell",
        "ProjectTabs",
        "Field",
        "Select",
        "Stepper",
        "Button"
      ],
      "scenarios": ["ready", "loading", "error", "long-content"],
      "checks": [
        {
          "id": "wizard-layout",
          "group": "layout",
          "expect": "Form card ba bước Project/Lead/Confirm, code và slug cùng hàng"
        },
        {
          "id": "wizard-fields",
          "group": "components",
          "expect": "Tên/type/template/root folder, custom select và validation từng field"
        },
        {
          "id": "wizard-footer",
          "group": "interactionGeometry",
          "expect": "Cancel trái/Continue phải, back giữ draft, footer không nhảy theo lỗi"
        },
        {
          "id": "wizard-density",
          "group": "density",
          "expect": "Một helper ngắn, optional Git/remote không chặn project research"
        }
      ]
    },
