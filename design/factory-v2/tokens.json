{
  "schemaVersion": 2,
  "theme": "asf-neutral",
  "reference": "plan/factory-v2/uiux-upgrade.md",
  "fonts": {
    "body": "Inter Variable, system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Consolas, monospace"
  },
  "typography": {
    "body": {
      "size": 14,
      "lineHeight": 20,
      "weight": 400
    },
    "meta": {
      "size": 12,
      "lineHeight": 18,
      "weight": 400
    },
    "title": {
      "size": 24,
      "lineHeight": 32,
      "weight": 600
    },
    "greeting": {
      "size": 28,
      "lineHeight": 36,
      "weight": 600
    },
    "section": {
      "size": 18,
      "lineHeight": 26,
      "weight": 600
    },
    "chat": {
      "size": 15,
      "lineHeight": 24,
      "weight": 400
    },
    "code": {
      "size": 13,
      "lineHeight": 20,
      "weight": 400
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "radii": {
    "chip": 6,
    "control": 8,
    "panel": 12
  },
  "sizes": {
    "sidebar": 248,
    "sidebarCollapsed": 64,
    "topbar": 52,
    "projectbar": 54,
    "gutter": 24,
    "gutterCompact": 16,
    "control": 34,
    "controlLarge": 40,
    "controlCompact": 28,
    "icon": 18,
    "arrow": 16,
    "chat": 440,
    "chatExpanded": 560,
    "boardColumnMin": 240,
    "boardColumnMax": 280
  },
  "breakpoints": {
    "mobile": 768,
    "compact": 1180,
    "desktop": 1440
  },
  "layers": {
    "shell": 10,
    "dock": 90,
    "panel": 100,
    "menu": 300,
    "modal": 400,
    "tooltip": 500
  },
  "motion": {
    "fast": 120,
    "normal": 180
  },
  "provenance": {
    "observedRaster": [
      "themes.dark.canvas",
      "themes.dark.surface",
      "themes.dark.border",
      "themes.dark.text",
      "themes.dark.primaryFill"
    ],
    "normalizedFromRaster": ["themes.dark.accent", "themes.dark.working"],
    "contrastAdjustments": [
      "themes.dark.controlBorder",
      "themes.dark.subtle",
      "themes.light.working"
    ],
    "fontStatus": "Inter Variable WOFF2 self-hosted, pinned revision/license/hashes in assets/font-manifest.json. Cmap verification automated; browser glyph rendering still requires visual QA.",
    "originalDprKnown": false,
    "comparisonViewportCss": [1600, 1000],
    "comparisonDpr": 2,
    "cssGeometryStatus": "Normalized implementation targets, not verified upstream CSS.",
    "lightPaletteStatus": "ASF proposal inspired by CrewHub; no verified local Light screenshot baseline."
  },
  "contrastPairs": [
    {
      "foreground": "text",
      "background": "surface",
      "minimum": 4.5
    },
    {
      "foreground": "muted",
      "background": "surface",
      "minimum": 4.5
    },
    {
      "foreground": "subtle",
      "background": "raised",
      "minimum": 4.5
    },
    {
      "foreground": "onPrimary",
      "background": "primaryFill",
      "minimum": 4.5
    },
    {
      "foreground": "onAccent",
      "background": "accent",
      "minimum": 4.5
    },
    {
      "foreground": "controlBorder",
      "background": "surface",
      "minimum": 3
    },
    {
      "foreground": "focus",
      "background": "raised",
      "minimum": 3
    },
    {
      "foreground": "statusAccent",
      "background": "surface",
      "minimum": 4.5
    },
    {
      "foreground": "working",
      "background": "surface",
      "minimum": 4.5
    },
    {
      "foreground": "text",
      "background": "raised",
      "minimum": 4.5
    },
    {
      "foreground": "success",
      "background": "successSurface",
      "minimum": 4.5
    },
    {
      "foreground": "danger",
      "background": "dangerSurface",
      "minimum": 4.5
    }
  ],
  "defaultTheme": "light",
  "themes": {
    "light": {
      "canvas": "#F6F7F9",
      "surface": "#FFFFFF",
      "raised": "#F0F2F5",
      "border": "#DEE2E8",
