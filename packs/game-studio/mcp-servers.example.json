{
  "servers": [
    {
      "name": "playwright",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless", "--isolated", "--output-dir", "{workspace}/.factory/playwright"],
      "clis": ["claude", "codex"]
    },
    {
      "name": "devtools",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--headless", "--isolated", "--no-usage-statistics"],
      "clis": ["claude", "codex"]
    }
  ]
}
