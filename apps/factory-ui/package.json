{
  "name": "@factory/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Factory V2 web UI (M1: shell, projects, Lead chat, tasks). Talks only to the Host API.",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "predev": "npm run tokens",
    "prebuild": "npm run tokens",
    "pretest": "npm run tokens",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui-build": "npm run build && npm --prefix ../factory-host run build",
    "e2e:work": "node e2e/work/run.mjs"
  },
  "dependencies": {
    "@factory/contracts": "file:../../packages/factory-contracts",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.62.0",
    "motion": "14.4.0",
    "radix-ui": "1.8.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
