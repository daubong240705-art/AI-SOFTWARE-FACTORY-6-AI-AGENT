{
  "name": "@factory/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Factory V2 web UI (M1: shell, projects, Lead chat, tasks). Talks only to the Host API.",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "predev": "npm run tokens",
    "prebuild": "npm run tokens",
    "pretest": "npm run tokens",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "test": "vitest run"
  },
  "dependencies": {
    "@factory/contracts": "file:../../packages/factory-contracts",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
