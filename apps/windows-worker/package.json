{
  "name": "asf-windows-worker",
  "productName": "ASF Windows Worker",
  "version": "1.3.0-alpha.7",
  "private": true,
  "description": "Local AI development workspace for Windows",
  "main": "out/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/launch.cjs dev",
    "start": "node scripts/launch.cjs preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/verify-sqlite.cjs",
    "test": "tsx --test tests/*.test.ts",
    "test:native": "node scripts/test-native.cjs",
    "format": "prettier --write electron shared src scripts tests *.json electron.vite.config.ts",
    "format:check": "prettier --check electron shared src scripts tests *.json electron.vite.config.ts"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.19.5",
    "@react-three/fiber": "9.8.2",
    "better-sqlite3": "13.0.3",
    "diff": "8.0.4",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "42.11.18",
    "electron-vite": "5.0.0",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
