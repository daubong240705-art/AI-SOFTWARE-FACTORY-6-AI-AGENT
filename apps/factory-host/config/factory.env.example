# Factory Host: factory setup, factory config show, factory doctor.
# Path: FACTORY_CONFIG, then $FACTORY_HOME/config/factory.env, then ~/.factory/config/factory.env.
# Set FACTORY_CONFIG/FACTORY_HOME in the launcher to select another file. Environment values override
# file values, then defaults apply. Use literal KEY=VALUE, single or double quotes, and # comments.
# Do not source this file as a shell script. Set mode 600 before adding an API key or token.

# OpenAI-compatible provider. Leave provider=none to run without a Lead model.
# If you set a base URL, remove the provider=none line or change it to openai-compatible.
FACTORY_MODEL_PROVIDER="none"
# FACTORY_MODEL_BASE_URL="https://api.example.com/v1"  # HTTPS, or HTTP on localhost only.
# FACTORY_MODEL_API_KEY=""  # Omit if the provider doesn't require a key.
# FACTORY_LEAD_MODEL="your-lead-model"  # Use an ID returned by GET /models.
# FACTORY_AGENT_MODELS="agent-one,agent-two"  # Up to eight provider model IDs.
# FACTORY_PROXY_PORT="8788"  # Local proxy port for api-agent; defaults to Host port + 1.
# FACTORY_LEAD_CLI="claude"  # Use the Claude CLI login for Lead instead of the HTTP provider.
# FACTORY_LEAD_EFFORT="medium"
# FACTORY_LEAD_MAX_OUTPUT_TOKENS="4096"
# FACTORY_LEAD_TIMEOUT_SECONDS="120"

# Host network settings. A non-loopback listen address requires a 24+ character token.
FACTORY_PORT="8787"
FACTORY_LISTEN_HOST="127.0.0.1"
# FACTORY_LOGIN_TOKEN="generate-a-long-random-token"
# FACTORY_OPEN_LOGIN="1"  # Loopback only. Otherwise provide a login token; Host does not log one.
# FACTORY_ALLOWED_HOSTS="factory.example.com"  # Additional permitted Host/Origin names.

# Optional paths. Defaults are under FACTORY_HOME on new installs; legacy factory-v2 paths are preserved.
# FACTORY_HOME="/home/you/.factory"
# FACTORY_STATE_DIR="/home/you/.factory/state"
# FACTORY_PROJECTS_ROOT="/home/you/.factory/workspaces"
# FACTORY_WORKTREES_ROOT="/home/you/.factory/worktrees"
# FACTORY_BACKUP_DIR="/home/you/.factory/state/backups/periodic"
# FACTORY_BACKUP_INTERVAL_MINUTES="60"
# FACTORY_MIGRATION_BACKUP_DIR="/home/you/.factory/state/backups"
# FACTORY_UI_DIR="/path/to/factory-ui/dist"

# Agent runtime, packs, and concurrency.
# FACTORY_LOCAL_CLI="1"  # Enable operator CLI agents with the operator's permissions.
# FACTORY_DEFAULT_AGENT_CLI="codex"  # codex or claude; requires FACTORY_LOCAL_CLI=1.
# FACTORY_CLI_PASS_ENV="NAME"  # Environment variable names to pass to local CLIs, not values.
# FACTORY_NODE_SLOTS="2"
# FACTORY_RUNTIME="fake"  # opencode requires a working bubblewrap and the following settings.
# FACTORY_OPENCODE_DIR="/path/to/opencode"
# FACTORY_PROXY_SOCKET="/home/you/.factory/state/proxy.sock"
# FACTORY_DEFAULT_PACK="software-team"
# FACTORY_PACKS="software-team,web-games"
# FACTORY_PACK_FOLLOW="web-games,portal-ops"  # Use none to stop following pack updates.
# FACTORY_MULTI_TEAM="0"
# FACTORY_GAME_STARTER_DIR="/path/to/game-starter"
# FACTORY_MCP_SERVERS_FILE="/path/to/mcp-servers.json"

# Limits, document worker, and integrations.
# FACTORY_BUDGET_TASK_TOKENS="200000"
# FACTORY_BUDGET_DAY_TOKENS="1000000"
# FACTORY_DOC_MAX_BYTES="26214400"
# FACTORY_DOC_QUOTA_BYTES="2147483648"
# FACTORY_DOC_WORKER="off"  # Optional; enabled by default when not set.
# FACTORY_DOC_WORKER_PYTHON="/path/to/venv/bin/python"
# FACTORY_DOC_WORKER_SCRIPT="/path/to/doc_worker.py"
# FACTORY_DOC_WORKER_COMMAND='["/path/to/doc-worker"]'
# FACTORY_PUSH_REMOTES="origin=https://git.example.com/team/repo.git"
# FACTORY_PUSH_SSH_COMMAND="ssh"
# FACTORY_PORTAL_URL="https://portal.example.com"
# FACTORY_PORTAL_PUBLIC_URL="https://portal.example.com"
# FACTORY_PORTAL_TOKEN=""
# FACTORY_PORTAL_ALLOW_PRIVATE_HTTP="0"
# FACTORY_TELEGRAM_BOT_TOKEN=""
# FACTORY_TELEGRAM_CHAT_ID=""
# FACTORY_TELEGRAM_ALLOWED_USERS=""
# FACTORY_DISCORD_WEBHOOK_URL=""
# FACTORY_NOTIFY_BASE_URL="https://factory.example.com"

# Legacy aliases: FACTORY_GATEWAY_URL and NINE_ROUTER_API_KEY still work. Don't set differing API keys.
# The deprecated key alias is read only with an explicit model base URL.
# Set NODE_EXTRA_CA_CERTS=/path/to/ca.pem in the launcher/service BEFORE starting Node.js.
# A file entry lets doctor check the path but won't change Node's trust store at runtime.
# NODE_EXTRA_CA_CERTS="/path/to/ca.pem"
# Tiện ích mở rộng (tùy chọn), phân cách bằng dấu phẩy. Mặc định không bật.
# FACTORY_EXTENSIONS=portal
# FACTORY_EXTENSIONS_DIR=/duong/dan/tuyet/doi/extensions
